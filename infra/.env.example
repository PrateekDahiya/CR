# CR Clone — example env (copy to .env; never commit real .env)
# Location: infra/.env.example -> copy:  Copy-Item infra/.env.example infra/.env
# Compose files use ${VAR:-default} fallbacks so stack runs even without .env.

POSTGRES_USER=cr
POSTGRES_PASSWORD=crpass
POSTGRES_DB=crdb
DATABASE_URL=postgresql://cr:crpass@postgres:5432/crdb
REDIS_URL=redis://redis:6379
BACKEND_URL=http://backend:4000
AI_URL=http://ai-service:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_AI_URL=http://localhost:8000
SEASON=s1
CORS_ORIGIN=http://localhost:3000
